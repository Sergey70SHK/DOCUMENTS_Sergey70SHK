# Конфигурация SK English Bot

# ОБЯЗАТЕЛЬНО: Замените your_bot_token_here на РЕАЛЬНЫЙ токен от @BotFather
# Получить токен: https://t.me/BotFather -> /newbot или /mybots
# Формат токена: 123456789:ABCdefGHIjklMNOpqrsTUVwxyz
BOT_TOKEN=your_bot_token_here

# Настройки логирования
LOG_LEVEL=INFO

# ID чата для тестирования (опционально)
# TEST_CHAT_ID=your_chat_id

# Настройки мониторинга
MAX_MEMORY_MB=500
CHECK_INTERVAL=60
MAX_RESTARTS=10

# Режим отладки (true/false)
DEBUG=false

# Webhook настройки (для продакшена, оставить пустым для polling)
# WEBHOOK_URL=https://yourdomain.com/webhook
# WEBHOOK_PORT=8443